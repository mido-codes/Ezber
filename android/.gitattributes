# Keep the Gradle wrapper usable on every platform. This repository may be
# checked out with core.autocrlf=true (as on the build host), which would turn
# gradlew's shebang into "#!/bin/sh\r" and break execution on Linux/macOS.
gradlew text eol=lf
gradlew.bat text eol=crlf
*.bat text eol=crlf
gradle/wrapper/gradle-wrapper.jar binary
