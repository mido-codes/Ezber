<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The content bundle is fetched lazily over HTTP (see content/ContentRepository),
      so the app needs INTERNET. Cleartext is limited to the dev hosts in
      res/xml/network_security_config.xml. The real Media3 background playback
      service will add FOREGROUND_SERVICE + FOREGROUND_SERVICE_MEDIA_PLAYBACK
      (and POST_NOTIFICATIONS for Android 13+) when it replaces
      StubAudioSessionService.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".EzberApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ezber">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Ezber">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
