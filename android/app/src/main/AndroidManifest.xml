<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Offline-first: no network, storage or audio permissions are needed for
      this slice because the content is bundled/placeholder and audio is
      stubbed. The real Media3 background playback service will add
      FOREGROUND_SERVICE + FOREGROUND_SERVICE_MEDIA_PLAYBACK (and POST_NOTIFICATIONS
      for Android 13+) when it replaces StubAudioSessionService.
    -->
    <application
        android:name=".EzberApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Ezber">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Ezber">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
